# callscope runs fully offline with no credentials. Everything below is optional.

# --- Optional: pyannote diarization backend -------------------------------
# Only needed if you pass --diarizer pyannote. Requires accepting the model
# licences at huggingface.co/pyannote/speaker-diarization-3.1 first.
# HUGGINGFACE_TOKEN=

# --- Optional: LLM judge for the semantic track ---------------------------
# Only needed if your rubric sets `judge: {backend: llm}`. Leaving this unset
# keeps callscope 100% local.
# ANTHROPIC_API_KEY=

# --- Optional: model selection --------------------------------------------
# CALLSCOPE_WHISPER_MODEL=mlx-community/whisper-large-v3-turbo
